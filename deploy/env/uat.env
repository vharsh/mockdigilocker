# UAT environment: closer to production behaviour.
ENV_NAME=uat
PORT=8080
PUBLIC_BASE_URL=https://mock-digilocker.uat.example.internal
STORE=postgres
DATABASE_URL=postgres://mockdl:CHANGE_ME@uat-postgres.internal:5432/mockdigilocker?sslmode=require
KV=redis
REDIS_ADDR=uat-redis.internal:6379
REDIS_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING
RSA_PRIVATE_KEY_FILE=/secrets/id_token_rsa.pem
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
SECURE_COOKIES=true
CORS_ORIGINS=https://uat.myapp.example.internal
# testers read the OTP from the console's OTP outbox
OTP_MODE=random
# don't print the OTP on the consent page
OTP_SHOW_HINT=false
# testers type credentials like real users
SHOW_TEST_USERS=false
# enforce ts/hmac on server-to-server APIs
HMAC_VALIDATION=strict
REQUIRE_PKCE=true
ACCESS_TOKEN_TTL=3600
AUTH_CODE_TTL=600
