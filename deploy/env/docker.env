# Docker Compose development: PostgreSQL + Redis.
ENV_NAME=docker
PORT=8080
STORE=postgres
DATABASE_URL=postgres://mockdl:mockdl-local-only@postgres:5432/mockdigilocker?sslmode=disable
KV=redis
REDIS_ADDR=redis:6379
OTP_MODE=fixed
OTP_FIXED_VALUE=123456
OTP_SHOW_HINT=true
SHOW_TEST_USERS=true
HMAC_VALIDATION=lenient
SESSION_SECRET=docker-dev-session-secret-change-me
# Uncomment with `--profile observability` to export traces to Jaeger:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
