# Local development: single binary, no external services.
#   set -a; source deploy/env/local.env; set +a; go run ./backend/cmd/server
ENV_NAME=local
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
STORE=memory
# persist across restarts (remove to start fresh every time)
DATA_FILE=./data/mockdl.json
KV=memory
OTP_MODE=fixed
OTP_FIXED_VALUE=123456
OTP_SHOW_HINT=true
SHOW_TEST_USERS=true
HMAC_VALIDATION=lenient
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
