# Shared QA environment (centrally hosted). Copy, fill in the blanks, keep out of git.
ENV_NAME=qa
PORT=8080
PUBLIC_BASE_URL=https://mock-digilocker.qa.example.internal
STORE=postgres
DATABASE_URL=postgres://mockdl:CHANGE_ME@qa-postgres.internal:5432/mockdigilocker?sslmode=require
KV=redis
REDIS_ADDR=qa-redis.internal:6379
REDIS_PASSWORD=CHANGE_ME
# required when running more than one replica
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# stable id_token signing key across restarts
RSA_PRIVATE_KEY_FILE=/secrets/id_token_rsa.pem
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
SECURE_COOKIES=true
CORS_ORIGINS=https://qa.myapp.example.internal
# QA automation types 123456
OTP_MODE=fixed
OTP_FIXED_VALUE=123456
OTP_SHOW_HINT=true
SHOW_TEST_USERS=true
HMAC_VALIDATION=lenient
REQUIRE_PKCE=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
